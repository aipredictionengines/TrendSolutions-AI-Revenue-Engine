{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "confidence",
    "reasons",
    "human_approval_required"
  ],
  "properties": {
    "action": {
      "enum": [
        "ASK",
        "HUMAN_HANDOFF",
        "READY_FOR_REVIEW"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_approval_required": {
      "const": true
    }
  }
}
